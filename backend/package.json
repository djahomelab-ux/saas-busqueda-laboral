{
  "name": "saas-busqueda-laboral-backend",
  "version": "0.2.0",
  "private": true,
  "description": "API REST del sistema inteligente integrador para la búsqueda laboral",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
